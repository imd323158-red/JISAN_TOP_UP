<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Evo Access</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<header class="topbar">

<div class="logo">
<span>⚡ Evo Access</span>
</div>

<a href="index.html" class="login-btn">🏠 Home</a>

</header>

<section class="category">

<h2>Choose Evo Access</h2>

<div class="grid">

<div class="card">
<h3>1 Evo Access</h3>
<p>৳60</p>
<button onclick="buy('1 Evo Access','60')">Buy Now</button>
</div>

<div class="card">
<h3>3 Evo Access</h3>
<p>৳170</p>
<button onclick="buy('3 Evo Access','170')">Buy Now</button>
</div>

<div class="card">
<h3>5 Evo Access</h3>
<p>৳280</p>
<button onclick="buy('5 Evo Access','280')">Buy Now</button>
</div>

<div class="card">
<h3>10 Evo Access</h3>
<p>৳550</p>
<button onclick="buy('10 Evo Access','550')">Buy Now</button>
</div>

</div>

</section>

<script>

function buy(pkg,price){

window.location.href =
`payment.html?package=${encodeURIComponent(pkg)}&price=${encodeURIComponent(price)}`;

}

</script>

</body>
</html>
